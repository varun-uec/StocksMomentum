{
  "name": "momentum25-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 --ext .ts,.tsx src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "cd ../backend && PYTHONPATH=src .venv/bin/python -c \"import json, sys; from momentum25.main import create_app; open(sys.argv[1], 'w').write(json.dumps(create_app().openapi()))\" ../web/openapi.tmp.json > /dev/null && cd ../web && openapi-typescript openapi.tmp.json -o src/lib/api-schema.ts && rm openapi.tmp.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-table": "^8.21.3",
    "lightweight-charts": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.5",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
