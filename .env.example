# ---- Copy to .env and adjust as needed. No secrets committed. ----

# Postgres (consumed by docker-compose and the API)
POSTGRES_USER=momentum25
POSTGRES_PASSWORD=momentum25
POSTGRES_DB=momentum25
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Service ports. Every port listens on loopback (127.0.0.1) only.
API_PORT=8000
# APP_BIND=0.0.0.0 exposes an unauthenticated app to your LAN. It is not secure
# for network exposure: every reachable browser has full read/write access.
# Keep loopback-only, or put an authenticating proxy in front of it.
APP_BIND=127.0.0.1
ADMINER_PORT=8080
REDISINSIGHT_PORT=5540

# ---- Backend application settings (prefix M25_) ----
# For local (non-docker) runs, point at localhost; docker-compose overrides these.
M25_DATABASE_URL=postgresql+asyncpg://momentum25:momentum25@localhost:5432/momentum25
M25_REDIS_URL=redis://localhost:6379/0
M25_DATA_PROVIDER=bhavcopy
# Direct exchange requests are opt-in. The default workflow imports authorized CSV exports.
M25_DIRECT_EXCHANGE_DOWNLOADS_ENABLED=false
M25_BENCHMARK_INDEX=NIFTY500
M25_SCHEDULE_CRON=30 18 * * 1-5
M25_TIMEZONE=Asia/Kolkata
M25_TIMESCALE_ENABLED=false
M25_SCHEDULER_ENABLED=false
M25_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
M25_LOG_LEVEL=INFO
M25_LOG_JSON=true
M25_ENVIRONMENT=development
M25_STRATEGY_DIR=../docs/architecture/strategies

# ---- Wickstreet 2.0 MF app (prefix WICKSTREET_; ADR-023) ----
# personal: one user, loopback only. saas is not built yet (Phase 2) and refuses to start.
WICKSTREET_MODE=personal
# Runtime role, under row-level security, and owner role, for MF migrations only.
# `wickstreet db-roles` creates both with these passwords; docker-compose overrides the hosts.
WICKSTREET_DATABASE_URL=postgresql+asyncpg://wickstreet_app:wickstreet_app@localhost:5432/momentum25
WICKSTREET_MIGRATION_DATABASE_URL=postgresql+asyncpg://wickstreet_owner:wickstreet_owner@localhost:5432/momentum25
WICKSTREET_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# MF data (ADR-022 §2.11, ADR-023 U10, U11). Raw source files stay outside the repository.
WICKSTREET_RAW_DIR=~/.wickstreet/raw
# Runs the 11:30 IST refresh inside the app. Compose sets it to true.
WICKSTREET_REFRESH_ENABLED=false
# AMFI's certificate chains to Sectigo R46. If SSL_CERT_FILE points at an older bundle
# (macOS /etc/ssl/cert.pem), HTTPS fails; unset it or point it at certifi's bundle.
